ARG NODE_IMAGE=docker.io/library/node:22-alpine
ARG NGINX_IMAGE=docker.io/library/nginx:1.27-alpine

# ── Stage 1: build ─────────────────────────────────────────────────────────────
FROM ${NODE_IMAGE} AS build
WORKDIR /src
COPY package.json package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY . .
RUN npm run build

# ── Stage 2: runtime ───────────────────────────────────────────────────────────
FROM ${NGINX_IMAGE}
RUN rm -f /etc/nginx/conf.d/default.conf
COPY nginx/nginx.conf     /etc/nginx/nginx.conf
COPY nginx/default.conf   /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html

# TLS certs are bind-mounted at runtime (compose/app/compose.yaml).

# uid 101 is the nginx unprivileged user.
USER 101:101

EXPOSE 8443

HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
  CMD wget -qO /dev/null --no-check-certificate https://127.0.0.1:8443/ || exit 1
