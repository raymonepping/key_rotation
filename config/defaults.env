# config/defaults.env — tracked defaults for image pins, host ports and names.
# scripts/compose.sh loads this file first and .env second, so any value can
# be overridden in .env without editing a compose file. scripts/common.sh and
# scripts/ports-check.sh read the same names.

# ── Images ────────────────────────────────────────────────────────────────────
# vault-s runs OSS (seal node only); vault-1 runs ENT (application Vault).
VAULT_IMAGE=docker.io/hashicorp/vault:2.0.4
VAULT_ENT_IMAGE=docker.io/hashicorp/vault-enterprise:2.0.4-ent
NODE_IMAGE=docker.io/library/node:22-alpine
NGINX_IMAGE=docker.io/library/nginx:1.27-alpine
ALPINE_IMAGE=docker.io/library/alpine:3.21

# ── Host ports (all published on 127.0.0.1) ───────────────────────────────────
# Chosen to run beside vault_portal (18500-18501, 13200-13201) without conflict.
KROT_PORT_VAULT_S=18700
KROT_PORT_VAULT_1=18701
KROT_PORT_API=13400
KROT_PORT_WEB=13401

# ── Application images (make app-build) ───────────────────────────────────────
KROT_IMAGE_PREFIX=localhost/key-rotation
KROT_IMAGE_TAG=local
